# Copie para .env e preencha. Nunca versione o .env.

# Banco de dados
POSTGRES_USER=bizo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=bizo_sala

# Chave para assinar sessões. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Usuário criado na primeira inicialização (se o banco não tiver nenhum)
ADMIN_EMAIL=seu.nome@ifc.edu.br
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Professor

# Produção (Cloudflare Tunnel em https://sala.bizo.dev.br)
# Porta local do nginx para onde o cloudflared aponta
NGINX_PORT=8080
# Só se usar o cloudflared em container (--profile tunnel)
TUNNEL_TOKEN=

# E-mail (Google Workspace, senha de app). Em dev o envio vai para o Mailpit.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu.nome@ifc.edu.br
# Senha de app do Google (https://myaccount.google.com/apppasswords), não a senha da conta
SMTP_PASSWORD=
# Intervalo entre e-mails, em segundos
EMAIL_INTERVALO_SEGUNDOS=1
